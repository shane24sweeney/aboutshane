{
  "info": {
    "_postman_id": "f0d7c7b1-6fd8-4e8c-8d98-2e5b1df34c1b",
    "name": "AboutShane API",
    "description": "Smoke and CORS checks for the AboutShane Spring Boot API running locally or behind AWS API Gateway and Lambda.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://7nofvoyvke.execute-api.us-east-1.amazonaws.com",
      "type": "string"
    },
    {
      "key": "frontendOrigin",
      "value": "https://selenium-automation.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Health status is ok', function () {",
              "    pm.expect(pm.response.json().status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Health with website CORS",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{frontendOrigin}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Website origin is allowed', function () {",
              "    pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql(pm.variables.get('frontendOrigin'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Health CORS preflight",
      "request": {
        "method": "OPTIONS",
        "header": [
          {
            "key": "Origin",
            "value": "{{frontendOrigin}}"
          },
          {
            "key": "Access-Control-Request-Method",
            "value": "GET"
          },
          {
            "key": "Access-Control-Request-Headers",
            "value": "content-type"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Preflight status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('GET is allowed', function () {",
              "    pm.expect(pm.response.headers.get('Access-Control-Allow-Methods')).to.include('GET');",
              "});",
              "pm.test('Website origin is allowed', function () {",
              "    pm.expect(pm.response.headers.get('Access-Control-Allow-Origin')).to.eql(pm.variables.get('frontendOrigin'));",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
