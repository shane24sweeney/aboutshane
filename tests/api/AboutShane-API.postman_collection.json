    {
      "name": "Visitors - last 30 days, or not yet available",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 JSON', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});",
              "const body = pm.response.json();",
              "if (body.available === false) {",
              "  pm.test('says the numbers are coming', () => pm.expect(body.message).to.be.a('string').and.not.empty);",
              "} else {",
              "  pm.test('has totals, countries and a US share', () => {",
              "    pm.expect(body.version).to.eql(1);",
              "    pm.expect(body.totals.users).to.be.at.least(0);",
              "    pm.expect(body.countries).to.be.an('array');",
              "    if (body.usShare !== null) pm.expect(body.usShare).to.be.within(0, 1);",
              "  });",
              "  pm.test('countries use two-letter codes, busiest first', () => {",
              "    const users = body.countries.map((c) => c.users);",
              "    pm.expect(users).to.eql([...users].sort((a, b) => b - a));",
              "    for (const c of body.countries) pm.expect(c.code).to.match(/^[A-Z]{2}$/);",
              "  });",
              "}"
            ]
          }
        }
      ],
