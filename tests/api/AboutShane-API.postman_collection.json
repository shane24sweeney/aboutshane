    {
      "name": "Status - reports the API and the latest tests",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 JSON, cacheable for a minute', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.headers.get('Cache-Control')).to.eql('max-age=60, public');",
              "});",
              "const body = pm.response.json();",
              "pm.test('says the API is ok and what it runs on', () => {",
              "  pm.expect(body.status).to.eql('ok');",
              "  pm.expect(body.runtime).to.match(/^Java \\d+$/);",
              "  pm.expect(body.uptimeSeconds).to.be.at.least(0);",
              "  pm.expect(new Date(body.startedAt).getTime()).to.be.below(Date.now() + 60000);",
              "});",
              "pm.test('counts the content', () => {",
              "  pm.expect(body.content.pages).to.eql(7);",
              "  pm.expect(body.content.races).to.be.above(0);",
              "});",
              "pm.test('includes the daily test verdict when the report is reachable', () => {",
              "  if (body.quality) pm.expect(['healthy', 'attention', 'incomplete']).to.include(body.quality.status);",
              "});"
            ]
          }
        }
      ],
