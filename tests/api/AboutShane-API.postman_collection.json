    {
      "name": "Content - running race history",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 JSON, cacheable for 5 minutes', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.headers.get('Cache-Control')).to.eql('max-age=300, public');",
              "});",
              "const running = pm.response.json();",
              "pm.test('links the Athlinks profile', () => pm.expect(running.profile.href).to.match(/^https:\\/\\/www\\.athlinks\\.com\\/athletes\\/\\d+$/));",
              "pm.test('every race is complete and placed within its field', () => {",
              "  pm.expect(running.races.length).to.be.at.least(24);",
              "  running.races.forEach((race) => {",
              "    pm.expect(race.date, race.event).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
              "    pm.expect(race.time, race.event).to.match(/^(\\d{1,2}:)?[0-5]?\\d:[0-5]\\d$/);",
              "    pm.expect(race.place, race.event).to.be.within(1, race.finishers);",
              "  });",
              "});",
              "pm.test('races are listed newest first', () => {",
              "  const dates = running.races.map((race) => race.date);",
              "  pm.expect(dates).to.eql([...dates].sort().reverse());",
              "});",
              "pm.collectionVariables.set('raceCount', running.races.length);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/content/running",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "content",
            "running"
          ]
        }
      }
    },
    {
      "name": "Content - running stats",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 JSON, cacheable for 5 minutes', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "  pm.expect(pm.response.headers.get('Cache-Control')).to.eql('max-age=300, public');",
              "});",
              "const stats = pm.response.json();",
              "pm.test('counts every race in the history', () => pm.expect(stats.races).to.eql(Number(pm.collectionVariables.get('raceCount'))));",
              "pm.test('has totals in the right form', () => {",
              "  pm.expect(stats.firstYear).to.be.at.most(stats.lastYear);",
              "  pm.expect(stats.totalMiles).to.be.above(0);",
              "  pm.expect(stats.totalTime).to.match(/^\\d+:[0-5]\\d:[0-5]\\d$/);",
              "});",
              "pm.test('lists one personal best per distance, shortest first', () => {",
              "  const distances = stats.personalBests.map((best) => best.distance);",
              "  pm.expect(new Set(distances).size).to.eql(distances.length);",
              "  const miles = stats.personalBests.map((best) => best.miles);",
              "  pm.expect(miles).to.eql([...miles].sort((a, b) => a - b));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
