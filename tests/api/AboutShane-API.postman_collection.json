    {
      "name": "Search - finds matches across pages",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 JSON, cacheable for 5 minutes', () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "  pm.expect(pm.response.headers.get('Cache-Control')).to.eql('max-age=300, public');",
              "});",
              "const body = pm.response.json();",
              "pm.test('echoes the query and counts the results', () => {",
              "  pm.expect(body.query).to.eql('appium');",
              "  pm.expect(body.count).to.eql(body.results.length);",
              "  pm.expect(body.count).to.be.within(2, 20);",
              "});",
              "pm.test('each result links to a page, with a snippet and highlights inside it', () => {",
              "  for (const result of body.results) {",
              "    pm.expect(result.path).to.match(/^\\/(home|about|resume|testimonials|education|charity|running)$/);",
              "    pm.expect(result.title).to.be.a('string').and.not.empty;",
              "    for (const h of result.highlights) pm.expect(h.start + h.length).to.be.at.most(result.snippet.length);",
              "  }",
              "});",
              "pm.test('finds the resume and the home page', () => {",
              "  const pages = body.results.map((r) => r.page);",
              "  pm.expect(pages).to.include('Resume');",
              "  pm.expect(pages).to.include('Home');",
              "});"
            ]
          }
        }
      ],
